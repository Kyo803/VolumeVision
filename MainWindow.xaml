<Window x:Class="VolumeOSD.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        Title="V^2" Width="328" Height="94"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        Visibility="Visible">
    <Window.Resources>
        <RadialGradientBrush x:Key="CursorGlow" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.6" RadiusY="0.6">
            <GradientStop Color="#30FFFFFF" Offset="0"/>
            <GradientStop Color="#00FFFFFF" Offset="1"/>
        </RadialGradientBrush>
    </Window.Resources>
    <Grid>
        <!-- Pill 300x66 = Figma 218x48 @1.38x, CornerRadius = height/2 -->
        <Border x:Name="Pill" Width="300" Height="66" CornerRadius="33"
                 RenderTransformOrigin="0.5,0.5"
                 MouseEnter="Pill_MouseEnter" MouseLeave="Pill_MouseLeave"
                 MouseMove="Pill_MouseMove" MouseLeftButtonDown="Pill_MouseDown"
                 MouseLeftButtonUp="Pill_MouseUp"
                Background="{DynamicResource PillBgBrush}"
                BorderBrush="{DynamicResource PillBorderBrush}" BorderThickness="1" Opacity="1">
            <Border.RenderTransform>
                <ScaleTransform x:Name="PillScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" Direction="270" ShadowDepth="10" Opacity="0.34" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <!-- Custom wallpaper (image or animated GIF), glass tint goes above it -->
                <Border x:Name="BgClip" CornerRadius="33" Visibility="Collapsed" ClipToBounds="True">
                    <Image x:Name="BgImage" Stretch="UniformToFill"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderTransformOrigin="0.5,0.5"/>
                </Border>
                <Border x:Name="GlassTint" CornerRadius="33" Visibility="Collapsed"
                        Background="{DynamicResource PillBgBrush}"/>
                <!-- Cursor-reactive liquid glow (wpf liquid glass Level 2) -->
                <Border x:Name="GlowLayer" CornerRadius="33" Background="{StaticResource CursorGlow}"
                        Opacity="0" IsHitTestVisible="False"/>
                <!-- Top specular highlight (approx of CSS inset top light) -->
                <Border x:Name="GlossOverlay" CornerRadius="33" Opacity="0.55">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#8CE6E6E6" Offset="0"/>
                            <GradientStop Color="#00282828" Offset="0.32"/>
                            <GradientStop Color="#00000000" Offset="0.55"/>
                            <GradientStop Color="#26E6E6E6" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- Design-space content stays at x4 coords, Viewbox scales it to x1.38 -->
                <Viewbox x:Name="OsdViewBox" Width="300" Height="66" Stretch="Uniform"
                         RenderOptions.BitmapScalingMode="HighQuality"
                         RenderOptions.EdgeMode="Unspecified"
                         UseLayoutRounding="True">
                <Grid Width="872" Height="192">
                <!-- ============ Frame 1: System Volume ============ -->
                <!-- Layout: speaker + gray track left, transport right -->
                <Canvas x:Name="SystemMode" Visibility="Visible" Width="872" Height="192">
                    <Canvas.RenderTransform>
                        <TranslateTransform x:Name="SysTrans" X="0"/>
                    </Canvas.RenderTransform>
                    <!-- Speaker 15x15*4=60, pos ~ (28,66) centered vertically -->
                    <Button x:Name="SysSpeakerBtn" Canvas.Left="20" Canvas.Top="60" Width="76" Height="72"
                            Style="{StaticResource OsdIconBtn}" Click="SpeakerBtn_Click" ToolTip="Click: media mode">
                        <Path x:Name="SysSpeakerPath" Width="60" Height="60" Stretch="Uniform" Fill="{DynamicResource IconFillBrush}" RenderTransformOrigin="0.5,0.5"
                              Data="M8.75 12.9531V11.6719C9.6875 11.401 10.4427 10.8802 11.0156 10.1094C11.5885 9.33854 11.875 8.46354 11.875 7.48438C11.875 6.50521 11.5885 5.63021 11.0156 4.85938C10.4427 4.08854 9.6875 3.56771 8.75 3.29688V2.01562C10.0417 2.30729 11.0938 2.96094 11.9063 3.97656C12.7188 4.99219 13.125 6.16146 13.125 7.48438C13.125 8.80729 12.7188 9.97656 11.9063 10.9922C11.0938 12.0078 10.0417 12.6615 8.75 12.9531ZM1.875 9.375V5.625H4.375L7.5 2.5V12.5L4.375 9.375H1.875ZM8.75 10V4.96875C9.23958 5.19792 9.6224 5.54167 9.89844 6C10.1745 6.45833 10.3125 6.95833 10.3125 7.5C10.3125 8.03125 10.1745 8.52344 9.89844 8.97656C9.6224 9.42969 9.23958 9.77083 8.75 10ZM6.25 5.53125L4.90625 6.875H3.125V8.125H4.90625L6.25 9.46875V5.53125Z"/>
                    </Button>

                    <!-- Track Frame1: 141x6*4 = 564x24 at (100,84) -->
                    <Border Canvas.Left="100" Canvas.Top="84" Width="564" Height="24" CornerRadius="12"
                            Background="{DynamicResource TrackBgBrush}" Cursor="Hand"
                            x:Name="SysTrack"
                            MouseLeftButtonDown="SysTrack_Down" MouseMove="SysTrack_Move" MouseLeftButtonUp="SysTrack_Up">
                        <Border x:Name="SysFill" HorizontalAlignment="Left" Width="280" Height="24" CornerRadius="12"
                                Background="{DynamicResource TrackFillGrayBrush}">
                            <Border x:Name="SysShimmer" CornerRadius="12"/>
                        </Border>
                    </Border>

                    <!-- Controls right, x=664 -->
                    <Button x:Name="SysPrevBtn" Canvas.Left="676" Canvas.Top="70" Width="52" Height="52"
                            Style="{StaticResource OsdIconBtn}" Click="PrevBtn_Click">
                        <Path Width="32" Height="32" Stretch="Uniform" Fill="{DynamicResource IconFillBrush}"
                              Data="M8.6 12L14.6 6L16 7.4L11.4 12L16 16.6L14.6 18L8.6 12Z"/>
                    </Button>
                    <!-- Play with small ring ~71px (17.8*4) -->
                    <Canvas Canvas.Left="732" Canvas.Top="60" Width="72" Height="72">
                        <Ellipse x:Name="SysDisc" Width="54" Height="54" Canvas.Left="9" Canvas.Top="9" Fill="#1DB954"/>
                        <Path x:Name="SysLogo" Width="54" Height="54" Canvas.Left="9" Canvas.Top="9" Stretch="Uniform" Fill="#191414"
                              Data="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/>
                        <!-- Album art covers the green/logo fallback when a track has a thumbnail (under ring+button) -->
                        <Ellipse x:Name="SysArt" Width="54" Height="54" Canvas.Left="9" Canvas.Top="9" Visibility="Collapsed">
                            <Ellipse.Fill>
                                <ImageBrush x:Name="SysArtBrush" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse x:Name="SysArtDim" Width="54" Height="54" Canvas.Left="9" Canvas.Top="9" Fill="#66000000" Visibility="Collapsed"/>
                        <Path x:Name="SysRing" Stroke="{DynamicResource RingGreenBrush}" StrokeThickness="7"
                              Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Button x:Name="SysPlayBtn" Canvas.Left="9" Canvas.Top="9" Width="54" Height="54"
                                Style="{StaticResource OsdIconBtn}" Click="PlayBtn_Click"/>
                    </Canvas>
                    <Button x:Name="SysNextBtn" Canvas.Left="808" Canvas.Top="70" Width="52" Height="52"
                            Style="{StaticResource OsdIconBtn}" Click="NextBtn_Click">
                        <Path Width="32" Height="32" Stretch="Uniform" Fill="{DynamicResource IconFillBrush}"
                              Data="M10.4501 9.5L6.80842 5.85833L7.91675 4.75L12.6667 9.5L7.91675 14.25L6.80841 13.1417L10.4501 9.5Z"/>
                    </Button>
                </Canvas>

                <!-- ============ Frame 2: Spotify / Media ============ -->
                <!-- Layout: transport left, green-tinted track right -->
                <Canvas x:Name="SpotifyMode" Visibility="Collapsed" Width="872" Height="192">
                    <Canvas.RenderTransform>
                        <TranslateTransform x:Name="SpotTrans" X="0"/>
                    </Canvas.RenderTransform>
                    <!-- Dimmed speaker 12x12*4=48 -->
                    <Button x:Name="SpotSpeakerBtn" Canvas.Left="24" Canvas.Top="72" Width="60" Height="48"
                            Style="{StaticResource OsdIconBtn}" Opacity="0.55" Click="SpeakerBtn_Click" ToolTip="Click: System volume">
                        <Path x:Name="SpotSpeakerPath" Width="48" Height="48" Stretch="Uniform" Fill="{DynamicResource IconFillBrush}" RenderTransformOrigin="0.5,0.5"
                              Data="M8.75 12.9531V11.6719C9.6875 11.401 10.4427 10.8802 11.0156 10.1094C11.5885 9.33854 11.875 8.46354 11.875 7.48438C11.875 6.50521 11.5885 5.63021 11.0156 4.85938C10.4427 4.08854 9.6875 3.56771 8.75 3.29688V2.01562C10.0417 2.30729 11.0938 2.96094 11.9063 3.97656C12.7188 4.99219 13.125 6.16146 13.125 7.48438C13.125 8.80729 12.7188 9.97656 11.9063 10.9922C11.0938 12.0078 10.0417 12.6615 8.75 12.9531ZM1.875 9.375V5.625H4.375L7.5 2.5V12.5L4.375 9.375H1.875ZM8.75 10V4.96875C9.23958 5.19792 9.6224 5.54167 9.89844 6C10.1745 6.45833 10.3125 6.95833 10.3125 7.5C10.3125 8.03125 10.1745 8.52344 9.89844 8.97656C9.6224 9.42969 9.23958 9.77083 8.75 10ZM6.25 5.53125L4.90625 6.875H3.125V8.125H4.90625L6.25 9.46875V5.53125Z"/>
                    </Button>

                    <!-- Controls left, x=68 -->
                    <Button x:Name="SpotPrevBtn" Canvas.Left="92" Canvas.Top="70" Width="52" Height="52"
                            Style="{StaticResource OsdIconBtn}" Click="PrevBtn_Click">
                        <Path Width="32" Height="32" Stretch="Uniform" Fill="{DynamicResource IconFillBrush}"
                              Data="M8.6 12L14.6 6L16 7.4L11.4 12L16 16.6L14.6 18L8.6 12Z"/>
                    </Button>
                    <!-- Play with full ring 23x23*4=92 -->
                    <Canvas Canvas.Left="148" Canvas.Top="50" Width="92" Height="92">
                        <Ellipse x:Name="SpotDisc" Width="72" Height="72" Canvas.Left="10" Canvas.Top="10" Fill="#1DB954"/>
                        <Path x:Name="SpotLogo" Width="72" Height="72" Canvas.Left="10" Canvas.Top="10" Stretch="Uniform" Fill="#191414"
                              Data="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/>
                        <!-- Album art covers the green/logo fallback when a track has a thumbnail (under ring+button) -->
                        <Ellipse x:Name="SpotArt" Width="72" Height="72" Canvas.Left="10" Canvas.Top="10" Visibility="Collapsed">
                            <Ellipse.Fill>
                                <ImageBrush x:Name="SpotArtBrush" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse x:Name="SpotArtDim" Width="72" Height="72" Canvas.Left="10" Canvas.Top="10" Fill="#66000000" Visibility="Collapsed"/>
                        <Path x:Name="SpotRing" Stroke="{DynamicResource RingGreenBrush}" StrokeThickness="8"
                              Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Button x:Name="SpotPlayBtn" Canvas.Left="10" Canvas.Top="10" Width="72" Height="72"
                                Style="{StaticResource OsdIconBtn}" Click="PlayBtn_Click"/>
                    </Canvas>
                    <Button x:Name="SpotNextBtn" Canvas.Left="244" Canvas.Top="70" Width="52" Height="52"
                            Style="{StaticResource OsdIconBtn}" Click="NextBtn_Click">
                        <Path Width="32" Height="32" Stretch="Uniform" Fill="{DynamicResource IconFillBrush}"
                              Data="M10.4501 9.5L6.80842 5.85833L7.91675 4.75L12.6667 9.5L7.91675 14.25L6.80841 13.1417L10.4501 9.5Z"/>
                    </Button>

                    <!-- Track Frame2: 127x6*4 = 508x24 at (316,88) + green tint -->
                    <Border Canvas.Left="316" Canvas.Top="84" Width="508" Height="24" CornerRadius="12"
                            Background="{DynamicResource TrackBgBrush}" Cursor="Hand"
                            x:Name="SpotTrack"
                            MouseLeftButtonDown="SpotTrack_Down" MouseMove="SpotTrack_Move" MouseLeftButtonUp="SpotTrack_Up">
    <Grid>
                            <Border x:Name="SpotFill" HorizontalAlignment="Left" Width="200" Height="24" CornerRadius="12"
                                    Background="{DynamicResource TrackFillGrayBrush}">
                                <Border x:Name="SpotShimmer" CornerRadius="12"/>
                            </Border>
                            <Border CornerRadius="12" Background="{DynamicResource SpotifyTintBrush}"/>
                        </Grid>
                    </Border>
                </Canvas>
                </Grid>
                </Viewbox>
            </Grid>
        </Border>
    </Grid>
</Window>
