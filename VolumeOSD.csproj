<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>VolumeOSD</RootNamespace>
    <AssemblyName>VolumeOSD</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>VolumeOSD</Authors>
    <Description>Custom Windows volume OSD pill with Spotify control (WPF, NAudio, SMTC)</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <!-- WinForms is only for the tray icon (aliased there); keep its namespaces
       out of the implicit set so they don't collide with WPF names. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
