<Application x:Class="VolumeOSD.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Figma pill spec: #000000 at 73% -> 0xBA, border #E8E8E8 0.5px, blur 6 -->
        <SolidColorBrush x:Key="PillBgBrush" Color="#BA000000"/>
        <SolidColorBrush x:Key="PillBorderBrush" Color="#E8E8E8"/>
        <SolidColorBrush x:Key="IconFillBrush" Color="#FEF7FF"/>
        <SolidColorBrush x:Key="TrackBgBrush" Color="#3A3A3A"/>
        <SolidColorBrush x:Key="TrackFillGrayBrush" Color="#8A8A8A"/>
        <SolidColorBrush x:Key="RingGreenBrush" Color="#2DA63B"/>
        <SolidColorBrush x:Key="InnerCircleBrush" Color="#D9D9D9"/>
        <!-- Frame2 green tint: #00E000 at 20% -> #3300E000 over gray -->
        <SolidColorBrush x:Key="SpotifyTintBrush" Color="#3300E000"/>

        <Style TargetType="Button" x:Key="OsdIconBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="24">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
