<Window x:Class="VolumeOSD.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        Title="V² Settings" Width="820" Height="420"
        Background="#111114" Foreground="#F2F2F5" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Modern dark slider: dark track + styled thumb -->
        <Style x:Key="DarkSlider" TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <!-- Dark background track (visual only) -->
                            <Border Height="5" CornerRadius="2.5" Background="#1E2530"
                                    VerticalAlignment="Center" Margin="0,0,0,14"/>
                            <!-- Track with functional thumb (WPF handles click-to-jump) -->
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="16" Height="16" Fill="#3A7BD5"
                                                         Stroke="#5A9BF0" StrokeThickness="1.5"
                                                         Effect="{DynamicResource ThumbShadow}"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DropShadowEffect x:Key="ThumbShadow" BlurRadius="3" ShadowDepth="0" Opacity="0.35" Color="Black"/>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== LEFT COLUMN ==================== -->
        <Grid Grid.Column="0" Margin="0,0,14,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- System Volume mini pill - exact live preview -->
            <Border Grid.Row="0" Width="320" Height="60" CornerRadius="30"
                    HorizontalAlignment="Left" Background="{DynamicResource PillBgBrush}"
                    BorderBrush="{DynamicResource PillBorderBrush}" BorderThickness="1" Margin="0,0,0,8" ClipToBounds="True">
                <Grid>
                    <Image x:Name="SysPreviewBg" Stretch="UniformToFill" Visibility="Collapsed"
                           gif:ImageBehavior.AnimatedSource="{Binding ElementName=SysPreviewBg, Path=Tag}"
                           gif:ImageBehavior.RepeatBehavior="Forever"/>
                    <Border Background="{DynamicResource PillBgBrush}" Opacity="0.45" CornerRadius="25"
                            x:Name="SysPreviewTint"/>
                    <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource IconFillBrush}"
                          Margin="0,0,8,0" VerticalAlignment="Center"
                          Data="M8.75 12.9531V11.6719C9.6875 11.401 10.4427 10.8802 11.0156 10.1094C11.5885 9.33854 11.875 8.46354 11.875 7.48438C11.875 6.50521 11.5885 5.63021 11.0156 4.85938C10.4427 4.08854 9.6875 3.56771 8.75 3.29688V2.01562C10.0417 2.30729 11.0938 2.96094 11.9063 3.97656C12.7188 4.99219 13.125 6.16146 13.125 7.48438C13.125 8.80729 12.7188 9.97656 11.9063 10.9922C11.0938 12.0078 10.0417 12.6615 8.75 12.9531ZM1.875 9.375V5.625H4.375L7.5 2.5V12.5L4.375 9.375H1.875ZM8.75 10V4.96875C9.23958 5.19792 9.6224 5.54167 9.89844 6C10.1745 6.45833 10.3125 6.95833 10.3125 7.5C10.3125 8.03125 10.1745 8.52344 9.89844 8.97656C9.6224 9.42969 9.23958 9.77083 8.75 10ZM6.25 5.53125L4.90625 6.875H3.125V8.125H4.90625L6.25 9.46875V5.53125Z"/>
                    <Border Grid.Column="1" Height="8" CornerRadius="4" Background="{DynamicResource TrackBgBrush}" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Border x:Name="SysTrackPreview" HorizontalAlignment="Left" Width="80" Height="8" CornerRadius="4"
                                Background="{DynamicResource TrackFillGrayBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource IconFillBrush}" Margin="0,0,6,0"
                              Data="M8.6 12L14.6 6L16 7.4L11.4 12L16 16.6L14.6 18L8.6 12Z"/>
                        <Ellipse x:Name="SysDiscPreview" Width="22" Height="22" Margin="0,0,6,0">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="#1DB954"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Path Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource IconFillBrush}"
                              Data="M10.4501 9.5L6.80842 5.85833L7.91675 4.75L12.6667 9.5L7.91675 14.25L6.80841 13.1417L10.4501 9.5Z"/>
                    </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Media mini pill - exact live preview -->
            <Border Grid.Row="1" Width="320" Height="60" CornerRadius="30"
                    HorizontalAlignment="Left" Background="{DynamicResource PillBgBrush}"
                    BorderBrush="{DynamicResource PillBorderBrush}" BorderThickness="1" Margin="0,0,0,8" ClipToBounds="True">
                <Grid>
                    <Image x:Name="SpotPreviewBg" Stretch="UniformToFill" Visibility="Collapsed"/>
                    <Border Background="{DynamicResource PillBgBrush}" Opacity="0.45" CornerRadius="25"
                            x:Name="SpotPreviewTint"/>
                    <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Path Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource IconFillBrush}" Margin="0,0,6,0"
                              Data="M8.6 12L14.6 6L16 7.4L11.4 12L16 16.6L14.6 18L8.6 12Z"/>
                        <Ellipse x:Name="SpotDiscPreview2" Width="22" Height="22" Margin="0,0,6,0">
                            <Ellipse.Fill><SolidColorBrush Color="#1DB954"/></Ellipse.Fill>
                        </Ellipse>
                        <Path Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource IconFillBrush}"
                              Data="M10.4501 9.5L6.80842 5.85833L7.91675 4.75L12.6667 9.5L7.91675 14.25L6.80841 13.1417L10.4501 9.5Z"/>
                    </StackPanel>
                    <Border Grid.Column="1" Height="8" CornerRadius="4" Background="{DynamicResource TrackBgBrush}" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Border x:Name="SpotTrackPreview" HorizontalAlignment="Left" Width="50" Height="8" CornerRadius="4"
                                Background="{DynamicResource TrackFillGrayBrush}"/>
                    </Border>
                    <Ellipse x:Name="SpotDiscPreview" Grid.Column="2" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,0,0">
                        <Ellipse.Fill><SolidColorBrush Color="#2DA63B"/></Ellipse.Fill>
                    </Ellipse>
                    </Grid>
                </Grid>
            </Border>

            <!-- Image / Apply / Clear -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6">
                <Button Content="Image" Padding="18,6" Margin="0,0,6,0" Click="BgPick_Click"
                        Background="#2AFFFFFF" Foreground="#F2F2F5" BorderThickness="0"
                        FontSize="12" FontWeight="SemiBold"/>
                <Button Content="Apply" Padding="18,6" Margin="0,0,6,0" Click="BgApply_Click"
                        Background="#2AFFFFFF" Foreground="#F2F2F5" BorderThickness="0"
                        FontSize="12" FontWeight="SemiBold"/>
                <Button Content="Clear" Padding="18,6" Click="BgClear_Click"
                        Background="#2AFFFFFF" Foreground="#F2F2F5" BorderThickness="0"
                        FontSize="12" FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Animations Only + Wallpaper Studio -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,6">
                <CheckBox x:Name="BgOnlyCheck" Content="Animations Only"
                          Foreground="#F2F2F5" Margin="0,0,12,0"
                          Checked="BgOnly_Toggled" Unchecked="BgOnly_Toggled"/>
                <Button Content="Wallpaper Studio" Padding="14,6" Click="Studio_Click"
                        Background="#2AFFFFFF" Foreground="#F2F2F5" BorderThickness="0"
                        FontSize="12" FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Live animated pill preview (bottom) -->
            <Border Grid.Row="4" Width="320" Height="60" CornerRadius="30"
                    HorizontalAlignment="Left" BorderThickness="1" Margin="0,0,0,2" ClipToBounds="True"
                    Background="{DynamicResource PillBgBrush}" BorderBrush="{DynamicResource PillBorderBrush}">
                <Grid>
                    <Image x:Name="LivePreviewBg" Stretch="UniformToFill" Visibility="Collapsed"/>
                    <Border Background="{DynamicResource PillBgBrush}" Opacity="0.45" CornerRadius="25"
                            x:Name="LivePreviewTint"/>
                    <Grid Margin="12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Fill><SolidColorBrush Color="#2DA63B"/></Ellipse.Fill>
                    </Ellipse>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource IconFillBrush}" Margin="0,0,6,0"
                              Data="M8.6 12L14.6 6L16 7.4L11.4 12L16 16.6L14.6 18L8.6 12Z"/>
                        <Path Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource IconFillBrush}"
                              Data="M10.4501 9.5L6.80842 5.85833L7.91675 4.75L12.6667 9.5L7.91675 14.25L6.80841 13.1417L10.4501 9.5Z"/>
                    </StackPanel>
                    <Border Grid.Column="2" Height="8" Width="80" CornerRadius="4" Background="{DynamicResource TrackBgBrush}" VerticalAlignment="Center" Margin="0,0,0,0">
                        <Border x:Name="LiveTrackPreview" HorizontalAlignment="Left" Width="55" Height="8" CornerRadius="4"
                                Background="{DynamicResource TrackFillGrayBrush}"/>
                    </Border>
                    </Grid>
                </Grid>
            </Border>
            <TextBlock Grid.Row="5" x:Name="BgName" Text="None" Foreground="#555555" FontSize="10" Margin="4,2,0,0"/>
        </Grid>

        <!-- ==================== RIGHT COLUMN ==================== -->
        <Grid Grid.Column="1" Margin="0,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Colors heading -->
            <TextBlock Grid.Row="0" Text="Colors" FontSize="20" FontWeight="SemiBold"
                       Foreground="#F2F2F5" Margin="0,0,0,4"/>
            <!-- Position (kept from earlier version, compact) -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0">
                <Button x:Name="PosTop" Content="Top" Padding="10,3" Margin="0,0,4,0" Click="Pos_Click" Tag="Top"
                        Background="#1AFFFFFF" Foreground="#F2F2F5" BorderThickness="0" FontSize="11"/>
                <Button x:Name="PosBottom" Content="Bottom" Padding="10,3" Margin="0,0,4,0" Click="Pos_Click" Tag="Bottom"
                        Background="#1AFFFFFF" Foreground="#F2F2F5" BorderThickness="0" FontSize="11"/>
                <Button x:Name="PosLeft" Content="Left" Padding="10,3" Margin="0,0,4,0" Click="Pos_Click" Tag="Left"
                        Background="#1AFFFFFF" Foreground="#F2F2F5" BorderThickness="0" FontSize="11"/>
                <Button x:Name="PosRight" Content="Right" Padding="10,3" Click="Pos_Click" Tag="Right"
                        Background="#1AFFFFFF" Foreground="#F2F2F5" BorderThickness="0" FontSize="11"/>
            </StackPanel>

            <!-- Color swatches: 2 columns -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Column 1 -->
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                        <TextBlock Text="Background" Width="130" VerticalAlignment="Center" Foreground="#CCCCCC" FontSize="12"/>
                        <Border x:Name="SwatchBg" Width="44" Height="18" CornerRadius="9"
                                Cursor="Hand" MouseLeftButtonDown="Swatch_Click" Tag="bg" Background="Gray"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                        <TextBlock Text="Border Ring" Width="130" VerticalAlignment="Center" Foreground="#CCCCCC" FontSize="12"/>
                        <Border x:Name="SwatchBorder" Width="44" Height="18" CornerRadius="9"
                                Cursor="Hand" MouseLeftButtonDown="Swatch_Click" Tag="border" Background="Gray"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                        <TextBlock Text="Track fill" Width="130" VerticalAlignment="Center" Foreground="#CCCCCC" FontSize="12"/>
                        <Border x:Name="SwatchTrackFill" Width="44" Height="18" CornerRadius="9"
                                Cursor="Hand" MouseLeftButtonDown="Swatch_Click" Tag="trackFill" Background="Gray"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                        <TextBlock Text="Audio Output Tint" Width="130" VerticalAlignment="Center" Foreground="#CCCCCC" FontSize="12"/>
                        <Border x:Name="SwatchTint" Width="44" Height="18" CornerRadius="9"
                                Cursor="Hand" MouseLeftButtonDown="Swatch_Click" Tag="tint" Background="Gray"/>
                    </StackPanel>
                </StackPanel>
                <!-- Column 2 -->
                <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                        <TextBlock Text="Progress Ring" Width="130" VerticalAlignment="Center" Foreground="#CCCCCC" FontSize="12"/>
                        <Border x:Name="SwatchRing" Width="44" Height="18" CornerRadius="9"
                                Cursor="Hand" MouseLeftButtonDown="Swatch_Click" Tag="ring" Background="Gray"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                        <TextBlock Text="Icons" Width="130" VerticalAlignment="Center" Foreground="#CCCCCC" FontSize="12"/>
                        <Border x:Name="SwatchIcons" Width="44" Height="18" CornerRadius="9"
                                Cursor="Hand" MouseLeftButtonDown="Swatch_Click" Tag="icons" Background="Gray"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Glass / Gloss / Size sliders -->
            <Grid Grid.Row="2" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Glass" VerticalAlignment="Center" Foreground="#CCCCCC" FontSize="12"/>
                <Slider x:Name="GlassSlider" Grid.Column="1" Minimum="40" Maximum="100" Value="73"
                        VerticalAlignment="Center" ValueChanged="Glass_Changed"
                        Style="{StaticResource DarkSlider}"
                        Margin="0,4,8,4"/>
                <TextBlock x:Name="GlassVal" Grid.Column="2" Text="73%" TextAlignment="Right" VerticalAlignment="Center"
                           Foreground="#777777" FontSize="12"/>

                <TextBlock Grid.Row="1" Text="Gloss" VerticalAlignment="Center" Foreground="#CCCCCC" FontSize="12"/>
                <Slider x:Name="GlossSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="150" Value="100"
                        VerticalAlignment="Center" ValueChanged="Gloss_Changed"
                        Style="{StaticResource DarkSlider}"
                        Margin="0,4,8,4"/>
                <TextBlock x:Name="GlossVal" Grid.Row="1" Grid.Column="2" Text="100%" TextAlignment="Right"
                           VerticalAlignment="Center" Foreground="#777777" FontSize="12"/>

                <TextBlock Grid.Row="2" Text="Size" VerticalAlignment="Center" Foreground="#CCCCCC" FontSize="12"/>
                <Slider x:Name="SizeSlider" Grid.Row="2" Grid.Column="1" Minimum="80" Maximum="250" Value="143"
                        VerticalAlignment="Center" ValueChanged="Size_Changed"
                        Style="{StaticResource DarkSlider}"
                        Margin="0,4,8,4"/>
                <TextBlock x:Name="SizeVal" Grid.Row="2" Grid.Column="2" Text="143%" TextAlignment="Right"
                           VerticalAlignment="Center" Foreground="#777777" FontSize="12"/>
            </Grid>

            <!-- Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,4">
                <Button Content="Reset to default" Padding="14,5" Margin="0,0,8,0" Click="Reset_Click"
                        Background="#2AFFFFFF" Foreground="#F2F2F5" BorderThickness="0"
                        FontSize="11" FontWeight="SemiBold"/>
            </StackPanel>

            <Button Grid.Row="4" Content="Uninstall V²" Padding="14,5" Click="Uninstall_Click"
                    Background="#2AFFFFFF" Foreground="#F2F2F5" BorderThickness="0"
                    FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Left" Margin="0,0,0,6"/>

            <!-- Hotkey hint -->
            <TextBlock Grid.Row="5" x:Name="HotkeyHint" Foreground="#444444" FontSize="9"
                       TextWrapping="Wrap" Margin="0,0,0,0"/>
        </Grid>
    </Grid>
</Window>
