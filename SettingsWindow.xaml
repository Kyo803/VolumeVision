<Window x:Class="VolumeOSD.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        Title="V² Settings" Width="820" Height="480"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">
    <Border x:Name="Shell" CornerRadius="20" Background="#0B0B0E" BorderBrush="#1E1E24" BorderThickness="1"
            RenderTransformOrigin="0.5,0.5" MouseLeftButtonDown="Shell_Drag">
        <Border.RenderTransform>
            <ScaleTransform x:Name="ShellScale" ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <Grid Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="296"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ==================== LEFT COLUMN ==================== -->
            <Grid Grid.Column="0" Margin="0,0,18,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- System volume preview -->
                <Border Grid.Row="0" Width="278" Height="56" CornerRadius="28" Margin="0,0,0,10"
                        Background="{DynamicResource PillBgBrush}" BorderBrush="{DynamicResource PillBorderBrush}"
                        BorderThickness="1" ClipToBounds="True">
                    <Grid>
                        <Image x:Name="SysPreviewBg" Stretch="UniformToFill" Visibility="Collapsed">
                            <Image.Clip>
                                <RectangleGeometry Rect="0,0,278,56" RadiusX="28" RadiusY="28"/>
                            </Image.Clip>
                        </Image>
                        <Border x:Name="SysPreviewTint" Background="{DynamicResource PillBgBrush}"
                                CornerRadius="28" Visibility="Collapsed"/>
                        <Grid Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"
                                  Fill="{DynamicResource IconFillBrush}" Margin="0,0,10,0"
                                  Data="M8.75 12.9531V11.6719C9.6875 11.401 10.4427 10.8802 11.0156 10.1094C11.5885 9.33854 11.875 8.46354 11.875 7.48438C11.875 6.50521 11.5885 5.63021 11.0156 4.85938C10.4427 4.08854 9.6875 3.56771 8.75 3.29688V2.01562C10.0417 2.30729 11.0938 2.96094 11.9063 3.97656C12.7188 4.99219 13.125 6.16146 13.125 7.48438C13.125 8.80729 12.7188 9.97656 11.9063 10.9922C11.0938 12.0078 10.0417 12.6615 8.75 12.9531ZM1.875 9.375V5.625H4.375L7.5 2.5V12.5L4.375 9.375H1.875ZM8.75 10V4.96875C9.23958 5.19792 9.6224 5.54167 9.89844 6C10.1745 6.45833 10.3125 6.95833 10.3125 7.5C10.3125 8.03125 10.1745 8.52344 9.89844 8.97656C9.6224 9.42969 9.23958 9.77083 8.75 10ZM6.25 5.53125L4.90625 6.875H3.125V8.125H4.90625L6.25 9.46875V5.53125Z"/>
                            <Border Grid.Column="1" Height="7" CornerRadius="3.5" Background="{DynamicResource TrackBgBrush}"
                                    VerticalAlignment="Center" Margin="0,0,10,0">
                                <Border x:Name="SysTrackPreview" HorizontalAlignment="Left" Width="90" Height="7"
                                        CornerRadius="3.5" Background="{DynamicResource TrackFillGrayBrush}"/>
                            </Border>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Width="11" Height="11" Stretch="Uniform" Fill="{DynamicResource IconFillBrush}"
                                      Margin="0,0,8,0"
                                      Data="M8.6 12L14.6 6L16 7.4L11.4 12L16 16.6L14.6 18L8.6 12Z"/>
                                <Grid Width="26" Height="26" Margin="0,0,8,0">
                                    <Ellipse Stroke="{DynamicResource RingGreenBrush}" StrokeThickness="2.6"/>
                                    <Ellipse Width="17" Height="17" Fill="#FFFFFF"/>
                                    <Path Width="8" Height="8" Stretch="Uniform" Fill="#0A0A0C"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M5.66675 13.4584V3.54169L13.4584 8.50002L5.66675 13.4584Z"/>
                                </Grid>
                                <Path Width="11" Height="11" Stretch="Uniform" Fill="{DynamicResource IconFillBrush}"
                                      Data="M10.4501 9.5L6.80842 5.85833L7.91675 4.75L12.6667 9.5L7.91675 14.25L6.80841 13.1417L10.4501 9.5Z"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Media preview -->
                <Border Grid.Row="1" Width="278" Height="56" CornerRadius="28" Margin="0,0,0,12"
                        Background="{DynamicResource PillBgBrush}" BorderBrush="{DynamicResource PillBorderBrush}"
                        BorderThickness="1" ClipToBounds="True">
                    <Grid>
                        <Image x:Name="SpotPreviewBg" Stretch="UniformToFill" Visibility="Collapsed">
                            <Image.Clip>
                                <RectangleGeometry Rect="0,0,278,56" RadiusX="28" RadiusY="28"/>
                            </Image.Clip>
                        </Image>
                        <Border x:Name="SpotPreviewTint" Background="{DynamicResource PillBgBrush}"
                                CornerRadius="28" Visibility="Collapsed"/>
                        <Grid Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"
                                  Fill="{DynamicResource IconFillBrush}" Opacity="0.6" Margin="0,0,10,0"
                                  Data="M8.75 12.9531V11.6719C9.6875 11.401 10.4427 10.8802 11.0156 10.1094C11.5885 9.33854 11.875 8.46354 11.875 7.48438C11.875 6.50521 11.5885 5.63021 11.0156 4.85938C10.4427 4.08854 9.6875 3.56771 8.75 3.29688V2.01562C10.0417 2.30729 11.0938 2.96094 11.9063 3.97656C12.7188 4.99219 13.125 6.16146 13.125 7.48438C13.125 8.80729 12.7188 9.97656 11.9063 10.9922C11.0938 12.0078 10.0417 12.6615 8.75 12.9531ZM1.875 9.375V5.625H4.375L7.5 2.5V12.5L4.375 9.375H1.875ZM8.75 10V4.96875C9.23958 5.19792 9.6224 5.54167 9.89844 6C10.1745 6.45833 10.3125 6.95833 10.3125 7.5C10.3125 8.03125 10.1745 8.52344 9.89844 8.97656C9.6224 9.42969 9.23958 9.77083 8.75 10ZM6.25 5.53125L4.90625 6.875H3.125V8.125H4.90625L6.25 9.46875V5.53125Z"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Path Width="11" Height="11" Stretch="Uniform" Fill="{DynamicResource IconFillBrush}"
                                      Margin="0,0,8,0"
                                      Data="M8.6 12L14.6 6L16 7.4L11.4 12L16 16.6L14.6 18L8.6 12Z"/>
                                <Grid Width="26" Height="26" Margin="0,0,8,0">
                                    <Ellipse Stroke="{DynamicResource RingGreenBrush}" StrokeThickness="2.6"/>
                                    <Ellipse Width="17" Height="17" Fill="#FFFFFF"/>
                                    <Path Width="8" Height="8" Stretch="Uniform" Fill="#0A0A0C"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M5.66675 13.4584V3.54169L13.4584 8.50002L5.66675 13.4584Z"/>
                                </Grid>
                                <Path Width="11" Height="11" Stretch="Uniform" Fill="{DynamicResource IconFillBrush}"
                                      Data="M10.4501 9.5L6.80842 5.85833L7.91675 4.75L12.6667 9.5L7.91675 14.25L6.80841 13.1417L10.4501 9.5Z"/>
                            </StackPanel>
                            <Border Grid.Column="2" Height="7" CornerRadius="3.5" Background="{DynamicResource TrackBgBrush}"
                                    VerticalAlignment="Center">
                                <Border x:Name="SpotTrackPreview" HorizontalAlignment="Left" Width="70" Height="7"
                                        CornerRadius="3.5" Background="{DynamicResource SpotifyTintBrush}"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Wallpaper actions -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Image" Style="{StaticResource PillButton}" Margin="0,0,8,0" Click="BgPick_Click"/>
                    <Button Content="Apply" Style="{StaticResource PillButton}" Margin="0,0,8,0" Click="BgApply_Click"/>
                    <Button Content="Clear" Style="{StaticResource PillButton}" Click="BgClear_Click"/>
                </StackPanel>

                <!-- Animations only + studio -->
                <Grid Grid.Row="3" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="BgOnlyCheck" Content="Animations Only" Style="{StaticResource PillCheck}"
                              VerticalAlignment="Center" Checked="BgOnly_Toggled" Unchecked="BgOnly_Toggled"/>
                    <Button Grid.Column="1" Content="Wallpaper Studio" Style="{StaticResource PillButton}"
                            HorizontalAlignment="Right" Click="Studio_Click"/>
                </Grid>

                <!-- Live preview -->
                <Border Grid.Row="4" Width="278" Height="56" CornerRadius="28" Margin="0,0,0,6"
                        Background="{DynamicResource PillBgBrush}" BorderBrush="{DynamicResource PillBorderBrush}"
                        BorderThickness="1" ClipToBounds="True">
                    <Grid>
                        <Image x:Name="LivePreviewBg" Stretch="UniformToFill" Visibility="Collapsed">
                            <Image.Clip>
                                <RectangleGeometry Rect="0,0,278,56" RadiusX="28" RadiusY="28"/>
                            </Image.Clip>
                        </Image>
                        <Border x:Name="LivePreviewTint" Background="{DynamicResource PillBgBrush}"
                                CornerRadius="28" Visibility="Collapsed"/>
                        <Grid Margin="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center"
                                  Fill="{DynamicResource IconFillBrush}" Opacity="0.6" Margin="0,0,10,0"
                                  Data="M8.75 12.9531V11.6719C9.6875 11.401 10.4427 10.8802 11.0156 10.1094C11.5885 9.33854 11.875 8.46354 11.875 7.48438C11.875 6.50521 11.5885 5.63021 11.0156 4.85938C10.4427 4.08854 9.6875 3.56771 8.75 3.29688V2.01562C10.0417 2.30729 11.0938 2.96094 11.9063 3.97656C12.7188 4.99219 13.125 6.16146 13.125 7.48438C13.125 8.80729 12.7188 9.97656 11.9063 10.9922C11.0938 12.0078 10.0417 12.6615 8.75 12.9531ZM1.875 9.375V5.625H4.375L7.5 2.5V12.5L4.375 9.375H1.875ZM8.75 10V4.96875C9.23958 5.19792 9.6224 5.54167 9.89844 6C10.1745 6.45833 10.3125 6.95833 10.3125 7.5C10.3125 8.03125 10.1745 8.52344 9.89844 8.97656C9.6224 9.42969 9.23958 9.77083 8.75 10ZM6.25 5.53125L4.90625 6.875H3.125V8.125H4.90625L6.25 9.46875V5.53125Z"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Path Width="11" Height="11" Stretch="Uniform" Fill="{DynamicResource IconFillBrush}"
                                      Margin="0,0,8,0"
                                      Data="M8.6 12L14.6 6L16 7.4L11.4 12L16 16.6L14.6 18L8.6 12Z"/>
                                <Grid Width="26" Height="26" Margin="0,0,8,0">
                                    <Ellipse Stroke="{DynamicResource RingGreenBrush}" StrokeThickness="2.6"/>
                                    <Ellipse Width="17" Height="17" Fill="#FFFFFF"/>
                                    <Path Width="8" Height="8" Stretch="Uniform" Fill="#0A0A0C"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M5.66675 13.4584V3.54169L13.4584 8.50002L5.66675 13.4584Z"/>
                                </Grid>
                                <Path Width="11" Height="11" Stretch="Uniform" Fill="{DynamicResource IconFillBrush}"
                                      Data="M10.4501 9.5L6.80842 5.85833L7.91675 4.75L12.6667 9.5L7.91675 14.25L6.80841 13.1417L10.4501 9.5Z"/>
                            </StackPanel>
                            <Border Grid.Column="2" Height="7" CornerRadius="3.5" Background="{DynamicResource TrackBgBrush}"
                                    VerticalAlignment="Center">
                                <Border x:Name="LiveTrackPreview" HorizontalAlignment="Left" Width="70" Height="7"
                                        CornerRadius="3.5" Background="{DynamicResource TrackFillGrayBrush}"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
                <TextBlock Grid.Row="5" x:Name="BgName" Text="None" Foreground="#55555E" FontSize="11"
                           Margin="4,0,0,0" VerticalAlignment="Top"/>
            </Grid>

            <!-- ==================== RIGHT COLUMN ==================== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header: title + close -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="Colors" FontSize="26" FontWeight="SemiBold" Foreground="#F4F4F7"/>
                    <Button x:Name="CloseBtn" Content="✕" Width="28" Height="28" HorizontalAlignment="Right"
                            VerticalAlignment="Top" Style="{StaticResource GhostPillButton}"
                            Padding="0" FontSize="12" Click="Close_Click"/>
                </Grid>

                <!-- Dock -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                    <Button x:Name="PosTop" Content="Top" Style="{StaticResource GhostPillButton}" Margin="0,0,6,0"
                            Click="Pos_Click" Tag="Top"/>
                    <Button x:Name="PosBottom" Content="Bottom" Style="{StaticResource GhostPillButton}" Margin="0,0,6,0"
                            Click="Pos_Click" Tag="Bottom"/>
                    <Button x:Name="PosLeft" Content="Left" Style="{StaticResource GhostPillButton}" Margin="0,0,6,0"
                            Click="Pos_Click" Tag="Left"/>
                    <Button x:Name="PosRight" Content="Right" Style="{StaticResource GhostPillButton}"
                            Click="Pos_Click" Tag="Right"/>
                </StackPanel>

                <!-- Swatches -->
                <Grid Grid.Row="2" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                        <Grid Margin="0,3">
                            <TextBlock Text="Background" Foreground="#DCDCE2" FontSize="13" VerticalAlignment="Center"/>
                            <Border x:Name="SwatchBg" Width="66" Height="22" CornerRadius="11" HorizontalAlignment="Right"
                                    Background="#FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                                    Cursor="Hand" MouseLeftButtonDown="Swatch_Click" Tag="bg"/>
                        </Grid>
                        <Grid Margin="0,3">
                            <TextBlock Text="Border Ring" Foreground="#DCDCE2" FontSize="13" VerticalAlignment="Center"/>
                            <Border x:Name="SwatchBorder" Width="66" Height="22" CornerRadius="11" HorizontalAlignment="Right"
                                    Background="#FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                                    Cursor="Hand" MouseLeftButtonDown="Swatch_Click" Tag="border"/>
                        </Grid>
                        <Grid Margin="0,3">
                            <TextBlock Text="Track fill" Foreground="#DCDCE2" FontSize="13" VerticalAlignment="Center"/>
                            <Border x:Name="SwatchTrackFill" Width="66" Height="22" CornerRadius="11" HorizontalAlignment="Right"
                                    Background="#FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                                    Cursor="Hand" MouseLeftButtonDown="Swatch_Click" Tag="trackFill"/>
                        </Grid>
                        <Grid Margin="0,3">
                            <TextBlock Text="Audio Output Tint" Foreground="#DCDCE2" FontSize="13" VerticalAlignment="Center"/>
                            <Border x:Name="SwatchTint" Width="66" Height="22" CornerRadius="11" HorizontalAlignment="Right"
                                    Background="#FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                                    Cursor="Hand" MouseLeftButtonDown="Swatch_Click" Tag="tint"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <Grid Margin="0,3">
                            <TextBlock Text="Progress Ring" Foreground="#DCDCE2" FontSize="13" VerticalAlignment="Center"/>
                            <Border x:Name="SwatchRing" Width="66" Height="22" CornerRadius="11" HorizontalAlignment="Right"
                                    Background="#FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                                    Cursor="Hand" MouseLeftButtonDown="Swatch_Click" Tag="ring"/>
                        </Grid>
                        <Grid Margin="0,3">
                            <TextBlock Text="Icons" Foreground="#DCDCE2" FontSize="13" VerticalAlignment="Center"/>
                            <Border x:Name="SwatchIcons" Width="66" Height="22" CornerRadius="11" HorizontalAlignment="Right"
                                    Background="#FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                                    Cursor="Hand" MouseLeftButtonDown="Swatch_Click" Tag="icons"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Sliders (2 columns) -->
                <Grid Grid.Row="3" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Column A -->
                    <Grid Grid.Column="0" Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Glass" Foreground="#DCDCE2" FontSize="12" VerticalAlignment="Center"/>
                        <Slider x:Name="GlassSlider" Grid.Column="1" Style="{StaticResource PillSlider}"
                                Minimum="40" Maximum="100" Value="73" VerticalAlignment="Center" Margin="0,0,8,0"
                                ValueChanged="Glass_Changed"/>
                        <TextBlock x:Name="GlassVal" Grid.Column="2" Text="73%" Foreground="#7A7A85" FontSize="11"
                                   TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Grid.Column="0" Grid.Row="1" Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Gloss" Foreground="#DCDCE2" FontSize="12" VerticalAlignment="Center"/>
                        <Slider x:Name="GlossSlider" Grid.Column="1" Style="{StaticResource PillSlider}"
                                Minimum="0" Maximum="150" Value="100" VerticalAlignment="Center" Margin="0,0,8,0"
                                ValueChanged="Gloss_Changed"/>
                        <TextBlock x:Name="GlossVal" Grid.Column="2" Text="100%" Foreground="#7A7A85" FontSize="11"
                                   TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Grid.Column="0" Grid.Row="2" Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Size" Foreground="#DCDCE2" FontSize="12" VerticalAlignment="Center"/>
                        <Slider x:Name="SizeSlider" Grid.Column="1" Style="{StaticResource PillSlider}"
                                Minimum="80" Maximum="250" Value="143" VerticalAlignment="Center" Margin="0,0,8,0"
                                ValueChanged="Size_Changed"/>
                        <TextBlock x:Name="SizeVal" Grid.Column="2" Text="143%" Foreground="#7A7A85" FontSize="11"
                                   TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Grid.Column="0" Grid.Row="3" Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Corner" Foreground="#DCDCE2" FontSize="12" VerticalAlignment="Center"/>
                        <Slider x:Name="CornerSlider" Grid.Column="1" Style="{StaticResource PillSlider}"
                                Minimum="15" Maximum="100" Value="100" VerticalAlignment="Center" Margin="0,0,8,0"
                                ValueChanged="Corner_Changed"/>
                        <TextBlock x:Name="CornerVal" Grid.Column="2" Text="100%" Foreground="#7A7A85" FontSize="11"
                                   TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Grid.Column="0" Grid.Row="4" Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Track" Foreground="#DCDCE2" FontSize="12" VerticalAlignment="Center"/>
                        <Slider x:Name="TrackSlider" Grid.Column="1" Style="{StaticResource PillSlider}"
                                Minimum="40" Maximum="250" Value="100" VerticalAlignment="Center" Margin="0,0,8,0"
                                ValueChanged="Track_Changed"/>
                        <TextBlock x:Name="TrackVal" Grid.Column="2" Text="100%" Foreground="#7A7A85" FontSize="11"
                                   TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Column B -->
                    <Grid Grid.Column="2" Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Border" Foreground="#DCDCE2" FontSize="12" VerticalAlignment="Center"/>
                        <Slider x:Name="BorderSlider" Grid.Column="1" Style="{StaticResource PillSlider}"
                                Minimum="0" Maximum="50" Value="10" VerticalAlignment="Center" Margin="0,0,8,0"
                                ValueChanged="Border_Changed"/>
                        <TextBlock x:Name="BorderVal" Grid.Column="2" Text="1.0" Foreground="#7A7A85" FontSize="11"
                                   TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Grid.Column="2" Grid.Row="1" Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Shadow" Foreground="#DCDCE2" FontSize="12" VerticalAlignment="Center"/>
                        <Slider x:Name="ShadowSlider" Grid.Column="1" Style="{StaticResource PillSlider}"
                                Minimum="0" Maximum="200" Value="100" VerticalAlignment="Center" Margin="0,0,8,0"
                                ValueChanged="Shadow_Changed"/>
                        <TextBlock x:Name="ShadowVal" Grid.Column="2" Text="100%" Foreground="#7A7A85" FontSize="11"
                                   TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Grid.Column="2" Grid.Row="2" Margin="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Glow" Foreground="#DCDCE2" FontSize="12" VerticalAlignment="Center"/>
                        <Slider x:Name="GlowSlider" Grid.Column="1" Style="{StaticResource PillSlider}"
                                Minimum="0" Maximum="200" Value="100" VerticalAlignment="Center" Margin="0,0,8,0"
                                ValueChanged="Glow_Changed"/>
                        <TextBlock x:Name="GlowVal" Grid.Column="2" Text="100%" Foreground="#7A7A85" FontSize="11"
                                   TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>

                <!-- Bottom actions -->
                <StackPanel Grid.Row="4" VerticalAlignment="Bottom">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                        <Button Content="Reset to&#10;default" Style="{StaticResource PillButton}" Margin="0,0,10,0"
                                Click="Reset_Click"/>
                        <Button Content="Uninstall&#10;V²" Style="{StaticResource PillButton}" Click="Uninstall_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="HotkeyHint" Foreground="#3E3E46" FontSize="10" TextWrapping="Wrap"
                               TextAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
