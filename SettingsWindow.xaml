<Window x:Class="VolumeOSD.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gif="http://wpfanimatedgif.codeplex.com"
        Title="V² Settings" Width="820" Height="500"
        Background="#111114" Foreground="#F2F2F5" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== LEFT COLUMN ==================== -->
        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- System Volume mini pill -->
            <Border Grid.Row="0" Width="280" Height="50" CornerRadius="25"
                    HorizontalAlignment="Left" Background="#18FFFFFF"
                    BorderBrush="#12FFFFFF" BorderThickness="1" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Width="16" Height="16" Stretch="Uniform" Fill="#E0E0E0"
                          Margin="12,0,8,0" VerticalAlignment="Center"
                          Data="M8.75 12.9531V11.6719C9.6875 11.401 10.4427 10.8802 11.0156 10.1094C11.5885 9.33854 11.875 8.46354 11.875 7.48438C11.875 6.50521 11.5885 5.63021 11.0156 4.85938C10.4427 4.08854 9.6875 3.56771 8.75 3.29688V2.01562C10.0417 2.30729 11.0938 2.96094 11.9063 3.97656C12.7188 4.99219 13.125 6.16146 13.125 7.48438C13.125 8.80729 12.7188 9.97656 11.9063 10.9922C11.0938 12.0078 10.0417 12.6615 8.75 12.9531ZM1.875 9.375V5.625H4.375L7.5 2.5V12.5L4.375 9.375H1.875ZM8.75 10V4.96875C9.23958 5.19792 9.6224 5.54167 9.89844 6C10.1745 6.45833 10.3125 6.95833 10.3125 7.5C10.3125 8.03125 10.1745 8.52344 9.89844 8.97656C9.6224 9.42969 9.23958 9.77083 8.75 10ZM6.25 5.53125L4.90625 6.875H3.125V8.125H4.90625L6.25 9.46875V5.53125Z"/>
                    <Border Grid.Column="1" Height="8" CornerRadius="4" Background="#22FFFFFF" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Border x:Name="SysTrackPreview" HorizontalAlignment="Left" Width="80" Height="8" CornerRadius="4"
                                Background="#8A8A8A"/>
                    </Border>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Width="12" Height="12" Stretch="Uniform" Fill="#E0E0E0" Margin="0,0,6,0"
                              Data="M8.6 12L14.6 6L16 7.4L11.4 12L16 16.6L14.6 18L8.6 12Z"/>
                        <Ellipse x:Name="SysDiscPreview" Width="22" Height="22" Fill="#1DB954" Margin="0,0,6,0"/>
                        <Path Width="12" Height="12" Stretch="Uniform" Fill="#E0E0E0"
                              Data="M10.4501 9.5L6.80842 5.85833L7.91675 4.75L12.6667 9.5L7.91675 14.25L6.80841 13.1417L10.4501 9.5Z"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Media mini pill -->
            <Border Grid.Row="1" Width="280" Height="50" CornerRadius="25"
                    HorizontalAlignment="Left" Background="#18FFFFFF"
                    BorderBrush="#12FFFFFF" BorderThickness="1" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,8,0">
                        <Path Width="12" Height="12" Stretch="Uniform" Fill="#999999" Margin="0,0,6,0"
                              Data="M8.6 12L14.6 6L16 7.4L11.4 12L16 16.6L14.6 18L8.6 12Z"/>
                        <Ellipse x:Name="SpotDiscPreview" Width="22" Height="22" Fill="#1DB954" Margin="0,0,6,0"/>
                        <Path Width="12" Height="12" Stretch="Uniform" Fill="#999999"
                              Data="M10.4501 9.5L6.80842 5.85833L7.91675 4.75L12.6667 9.5L7.91675 14.25L6.80841 13.1417L10.4501 9.5Z"/>
                    </StackPanel>
                    <Border Grid.Column="1" Height="8" CornerRadius="4" Background="#22FFFFFF" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Border x:Name="SpotTrackPreview" HorizontalAlignment="Left" Width="50" Height="8" CornerRadius="4"
                                Background="#8A8A8A"/>
                    </Border>
                    <Ellipse Grid.Column="2" Width="22" Height="22" Fill="#2DA63B" VerticalAlignment="Center" Margin="0,0,12,0"/>
                </Grid>
            </Border>

            <!-- Image / Apply / Clear -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="Image" Padding="18,6" Margin="0,0,6,0" Click="BgPick_Click"
                        Background="#2AFFFFFF" Foreground="#F2F2F5" BorderThickness="0"
                        FontSize="12" FontWeight="SemiBold"/>
                <Button Content="Apply" Padding="18,6" Margin="0,0,6,0" Click="BgApply_Click"
                        Background="#2AFFFFFF" Foreground="#F2F2F5" BorderThickness="0"
                        FontSize="12" FontWeight="SemiBold"/>
                <Button Content="Clear" Padding="18,6" Click="BgClear_Click"
                        Background="#2AFFFFFF" Foreground="#F2F2F5" BorderThickness="0"
                        FontSize="12" FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Animations Only + Wallpaper Studio -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
                <CheckBox x:Name="BgOnlyCheck" Content="Animations Only"
                          Foreground="#F2F2F5" Margin="0,0,12,0"
                          Checked="BgOnly_Toggled" Unchecked="BgOnly_Toggled"/>
                <Button Content="Wallpaper Studio" Padding="14,6" Click="Studio_Click"
                        Background="#2AFFFFFF" Foreground="#F2F2F5" BorderThickness="0"
                        FontSize="12" FontWeight="SemiBold"/>
            </StackPanel>

            <!-- Live animated pill preview (bottom) -->
            <Border Grid.Row="4" Width="280" Height="50" CornerRadius="25"
                    HorizontalAlignment="Left" Background="#18FFFFFF"
                    BorderBrush="#12FFFFFF" BorderThickness="1" Margin="0,0,0,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Grid.Column="0" Width="22" Height="22" Fill="#2DA63B" VerticalAlignment="Center" Margin="12,0,8,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Width="12" Height="12" Stretch="Uniform" Fill="#999999" Margin="0,0,6,0"
                              Data="M8.6 12L14.6 6L16 7.4L11.4 12L16 16.6L14.6 18L8.6 12Z"/>
                        <Path Width="12" Height="12" Stretch="Uniform" Fill="#999999"
                              Data="M10.4501 9.5L6.80842 5.85833L7.91675 4.75L12.6667 9.5L7.91675 14.25L6.80841 13.1417L10.4501 9.5Z"/>
                    </StackPanel>
                    <Border Grid.Column="2" Height="8" Width="80" CornerRadius="4" Background="#22FFFFFF" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Border x:Name="LiveTrackPreview" HorizontalAlignment="Left" Width="55" Height="8" CornerRadius="4"
                                Background="#8A8A8A"/>
                    </Border>
                </Grid>
            </Border>
            <TextBlock Grid.Row="5" x:Name="BgName" Text="None" Foreground="#555555" FontSize="11" Margin="4,0,0,0"/>
        </Grid>

        <!-- ==================== RIGHT COLUMN ==================== -->
        <Grid Grid.Column="1" Margin="0,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Colors heading -->
            <TextBlock Grid.Row="0" Text="Colors" FontSize="24" FontWeight="SemiBold"
                       Foreground="#F2F2F5" Margin="0,0,0,10"/>

            <!-- Color swatches: 2 columns -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Column 1 -->
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                        <TextBlock Text="Background" Width="130" VerticalAlignment="Center" Foreground="#CCCCCC" FontSize="13"/>
                        <Border x:Name="SwatchBg" Width="48" Height="20" CornerRadius="10"
                                Cursor="Hand" MouseLeftButtonDown="Swatch_Click" Tag="bg" Background="Gray"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                        <TextBlock Text="Border Ring" Width="130" VerticalAlignment="Center" Foreground="#CCCCCC" FontSize="13"/>
                        <Border x:Name="SwatchBorder" Width="48" Height="20" CornerRadius="10"
                                Cursor="Hand" MouseLeftButtonDown="Swatch_Click" Tag="border" Background="Gray"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                        <TextBlock Text="Track fill" Width="130" VerticalAlignment="Center" Foreground="#CCCCCC" FontSize="13"/>
                        <Border x:Name="SwatchTrackFill" Width="48" Height="20" CornerRadius="10"
                                Cursor="Hand" MouseLeftButtonDown="Swatch_Click" Tag="trackFill" Background="Gray"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                        <TextBlock Text="Audio Output Tint" Width="130" VerticalAlignment="Center" Foreground="#CCCCCC" FontSize="13"/>
                        <Border x:Name="SwatchTint" Width="48" Height="20" CornerRadius="10"
                                Cursor="Hand" MouseLeftButtonDown="Swatch_Click" Tag="tint" Background="Gray"/>
                    </StackPanel>
                </StackPanel>
                <!-- Column 2 -->
                <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                        <TextBlock Text="Progress Ring" Width="130" VerticalAlignment="Center" Foreground="#CCCCCC" FontSize="13"/>
                        <Border x:Name="SwatchRing" Width="48" Height="20" CornerRadius="10"
                                Cursor="Hand" MouseLeftButtonDown="Swatch_Click" Tag="ring" Background="Gray"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                        <TextBlock Text="Icons" Width="130" VerticalAlignment="Center" Foreground="#CCCCCC" FontSize="13"/>
                        <Border x:Name="SwatchIcons" Width="48" Height="20" CornerRadius="10"
                                Cursor="Hand" MouseLeftButtonDown="Swatch_Click" Tag="icons" Background="Gray"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Glass / Gloss / Size sliders -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Glass" VerticalAlignment="Center" Foreground="#CCCCCC" FontSize="13"/>
                <Slider x:Name="GlassSlider" Grid.Column="1" Minimum="40" Maximum="100" Value="73"
                        VerticalAlignment="Center" ValueChanged="Glass_Changed"
                        TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                        Margin="0,0,8,0"/>
                <TextBlock x:Name="GlassVal" Grid.Column="2" Text="73%" TextAlignment="Right" VerticalAlignment="Center"
                           Foreground="#777777" FontSize="12"/>

                <TextBlock Grid.Row="1" Text="Gloss" VerticalAlignment="Center" Foreground="#CCCCCC" FontSize="13"/>
                <Slider x:Name="GlossSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="150" Value="100"
                        VerticalAlignment="Center" ValueChanged="Gloss_Changed"
                        TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                        Margin="0,0,8,0"/>
                <TextBlock x:Name="GlossVal" Grid.Row="1" Grid.Column="2" Text="100%" TextAlignment="Right"
                           VerticalAlignment="Center" Foreground="#777777" FontSize="12"/>

                <TextBlock Grid.Row="2" Text="Size" VerticalAlignment="Center" Foreground="#CCCCCC" FontSize="13"/>
                <Slider x:Name="SizeSlider" Grid.Row="2" Grid.Column="1" Minimum="80" Maximum="250" Value="143"
                        VerticalAlignment="Center" ValueChanged="Size_Changed"
                        TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                        Margin="0,0,8,0"/>
                <TextBlock x:Name="SizeVal" Grid.Row="2" Grid.Column="2" Text="143%" TextAlignment="Right"
                           VerticalAlignment="Center" Foreground="#777777" FontSize="12"/>
            </Grid>

            <!-- Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,8">
                <Button Content="Reset to default" Padding="18,7" Margin="0,0,8,0" Click="Reset_Click"
                        Background="#2AFFFFFF" Foreground="#F2F2F5" BorderThickness="0"
                        FontSize="12" FontWeight="SemiBold"/>
            </StackPanel>

            <Button Grid.Row="4" Content="Uninstall V²" Padding="18,7" Click="Uninstall_Click"
                    Background="#2AFFFFFF" Foreground="#F2F2F5" BorderThickness="0"
                    FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Left"/>

            <!-- Hotkey hint -->
            <TextBlock Grid.Row="5" x:Name="HotkeyHint" Foreground="#444444" FontSize="10"
                       TextWrapping="Wrap" Margin="0,8,0,0"/>
        </Grid>
    </Grid>
</Window>
