<Window x:Class="VolumeOSD.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VolumeOSD Settings" Width="380" SizeToContent="Height"
        Background="#111114" Foreground="#F2F2F5" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="16" Orientation="Vertical">
        <TextBlock Text="Preview" FontWeight="Bold" Margin="0,0,0,6"/>
        <Border Width="320" Height="72" CornerRadius="36" HorizontalAlignment="Center"
                Background="{DynamicResource PillBgBrush}"
                BorderBrush="{DynamicResource PillBorderBrush}" BorderThickness="1" Margin="0,0,0,12">
            <Grid>
                <Border x:Name="PreviewGloss" CornerRadius="36" Opacity="0.55">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#8CE6E6E6" Offset="0"/>
                            <GradientStop Color="#00282828" Offset="0.32"/>
                            <GradientStop Color="#00000000" Offset="0.55"/>
                            <GradientStop Color="#26E6E6E6" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Path Width="24" Height="24" Stretch="Uniform" Fill="{DynamicResource IconFillBrush}" VerticalAlignment="Center"
                          Data="M8.75 12.9531V11.6719C9.6875 11.401 10.4427 10.8802 11.0156 10.1094C11.5885 9.33854 11.875 8.46354 11.875 7.48438C11.875 6.50521 11.5885 5.63021 11.0156 4.85938C10.4427 4.08854 9.6875 3.56771 8.75 3.29688V2.01562C10.0417 2.30729 11.0938 2.96094 11.9063 3.97656C12.7188 4.99219 13.125 6.16146 13.125 7.48438C13.125 8.80729 12.7188 9.97656 11.9063 10.9922C11.0938 12.0078 10.0417 12.6615 8.75 12.9531ZM1.875 9.375V5.625H4.375L7.5 2.5V12.5L4.375 9.375H1.875ZM8.75 10V4.96875C9.23958 5.19792 9.6224 5.54167 9.89844 6C10.1745 6.45833 10.3125 6.95833 10.3125 7.5C10.3125 8.03125 10.1745 8.52344 9.89844 8.97656C9.6224 9.42969 9.23958 9.77083 8.75 10ZM6.25 5.53125L4.90625 6.875H3.125V8.125H4.90625L6.25 9.46875V5.53125Z"/>
                    <Border Width="140" Height="10" CornerRadius="5" Margin="10,0,10,0"
                            Background="{DynamicResource TrackBgBrush}" VerticalAlignment="Center">
                        <Grid>
                            <Border HorizontalAlignment="Left" Width="84" Height="10" CornerRadius="5"
                                    Background="{DynamicResource TrackFillGrayBrush}"/>
                            <Border CornerRadius="5" Background="{DynamicResource SpotifyTintBrush}"/>
                        </Grid>
                    </Border>
                    <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource IconFillBrush}" VerticalAlignment="Center"
                          Data="M8.6 12L14.6 6L16 7.4L11.4 12L16 16.6L14.6 18L8.6 12Z"/>
                    <Grid Width="40" Height="40" Margin="6,0,6,0">
                        <Ellipse Stroke="{DynamicResource RingGreenBrush}" StrokeThickness="4"/>
                        <Ellipse Width="30" Height="30" Fill="#1DB954"/>
                        <Path Width="14" Height="14" Stretch="Uniform" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M5.66675 13.4584V3.54169L13.4584 8.50002L5.66675 13.4584Z"/>
                    </Grid>
                    <Path Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource IconFillBrush}" VerticalAlignment="Center"
                          Data="M10.4501 9.5L6.80842 5.85833L7.91675 4.75L12.6667 9.5L7.91675 14.25L6.80841 13.1417L10.4501 9.5Z"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Text="Position" FontWeight="Bold" Margin="0,0,0,6"/>
        <UniformGrid Columns="4" Margin="0,0,0,4">
            <Button x:Name="PosTop" Content="Top" Margin="0,0,4,0" Padding="0,6" Click="Pos_Click" Tag="Top"/>
            <Button x:Name="PosBottom" Content="Bottom" Margin="0,0,4,0" Padding="0,6" Click="Pos_Click" Tag="Bottom"/>
            <Button x:Name="PosLeft" Content="Left ⟲" Margin="0,0,4,0" Padding="0,6" Click="Pos_Click" Tag="Left"/>
            <Button x:Name="PosRight" Content="Right ⟳" Padding="0,6" Click="Pos_Click" Tag="Right"/>
        </UniformGrid>
        <TextBlock x:Name="PosHint" Text="Bottom dock" Foreground="#9A9AA5" FontSize="11" Margin="0,0,0,10"/>

        <TextBlock Text="Wallpaper" FontWeight="Bold" Margin="0,0,0,6"/>
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="BgPickBtn" Content="Use image…" Padding="0,6" Margin="0,0,4,0" Click="BgPick_Click"/>
            <Button x:Name="BgClearBtn" Content="Clear" Grid.Column="1" Padding="0,6" Margin="4,0,0,0" Click="BgClear_Click"/>
        </Grid>
        <Button x:Name="StudioBtn" Content="Wallpaper studio — crop &amp; animate…" Margin="0,6,0,0" Padding="0,6" Click="Studio_Click"/>
        <CheckBox x:Name="BgOnlyCheck" Content="Animation only — hide the solid color" Margin="0,6,0,0" Foreground="#F2F2F5" Checked="BgOnly_Toggled" Unchecked="BgOnly_Toggled"/>
        <TextBlock x:Name="BgName" Text="None (solid color)" Foreground="#9A9AA5" FontSize="11" Margin="0,4,0,10"/>

        <TextBlock Text="Colors (hex)" FontWeight="Bold" Margin="0,0,0,6"/>
        <Grid x:Name="ColorGrid" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>
        </Grid>

        <TextBlock Text="Color grading" FontWeight="Bold" Margin="0,0,0,6"/>
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="44"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Glass" VerticalAlignment="Center"/>
            <Slider x:Name="GlassSlider" Grid.Column="1" Minimum="40" Maximum="100" VerticalAlignment="Center" ValueChanged="Glass_Changed"/>
            <TextBlock x:Name="GlassVal" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="1" Text="Gloss" VerticalAlignment="Center"/>
            <Slider x:Name="GlossSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="150" VerticalAlignment="Center" ValueChanged="Gloss_Changed"/>
            <TextBlock x:Name="GlossVal" Grid.Row="1" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="2" Text="Size" VerticalAlignment="Center"/>
            <Slider x:Name="ScaleSlider" Grid.Row="2" Grid.Column="1" Minimum="80" Maximum="250" VerticalAlignment="Center" ValueChanged="Scale_Changed"/>
            <TextBlock x:Name="ScaleVal" Grid.Row="2" Grid.Column="2" TextAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <Button x:Name="ResetBtn" Content="Reset to defaults" Margin="0,8,0,0" Padding="0,6" Click="Reset_Click"/>
        <CheckBox x:Name="FxCheck" Content="Animated slider shimmer" Margin="0,8,0,0" Foreground="#F2F2F5" Checked="Fx_Toggled" Unchecked="Fx_Toggled"/>
        <Button x:Name="UninstallBtn" Content="Uninstall VolumeOSD…" Margin="0,6,0,0" Padding="0,6" Click="Uninstall_Click"/>
        <TextBlock x:Name="HotkeyHint" Foreground="#9A9AA5" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </StackPanel>
</Window>
