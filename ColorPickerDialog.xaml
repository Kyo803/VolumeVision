<Window x:Class="VolumeOSD.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick a color" Width="480" SizeToContent="Height" Topmost="True"
        Background="#111114" Foreground="#F2F2F5" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Saturation/Value square -->
        <Canvas x:Name="SvCanvas" Width="200" Height="200" Cursor="Cross"
                MouseLeftButtonDown="Sv_Down" MouseMove="Sv_Move" MouseLeftButtonUp="Sv_Up">
            <Border x:Name="SvBase" Width="200" Height="200"/>
            <Border Width="200" Height="200">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="White" Offset="0"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border Width="200" Height="200">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0"/>
                        <GradientStop Color="Black" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Ellipse x:Name="SvThumb" Width="12" Height="12" Stroke="White" StrokeThickness="2" Fill="Transparent"/>
        </Canvas>

        <!-- Hue strip -->
        <Canvas x:Name="HueCanvas" Grid.Column="1" Width="24" Height="200" Margin="12,0,0,0" Cursor="Cross"
                MouseLeftButtonDown="Hue_Down" MouseMove="Hue_Move" MouseLeftButtonUp="Hue_Up">
            <Border Width="24" Height="200">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF0000" Offset="0"/>
                        <GradientStop Color="#FFFF00" Offset="0.167"/>
                        <GradientStop Color="#00FF00" Offset="0.333"/>
                        <GradientStop Color="#00FFFF" Offset="0.5"/>
                        <GradientStop Color="#0000FF" Offset="0.667"/>
                        <GradientStop Color="#FF00FF" Offset="0.833"/>
                        <GradientStop Color="#FF0000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border x:Name="HueMarker" Width="28" Height="4" Canvas.Left="-2" Background="White"/>
        </Canvas>

        <!-- Fields -->
        <StackPanel Grid.Column="2" Margin="14,0,0,0">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="New" Foreground="#9A9AA5" FontSize="11"/>
                    <Border x:Name="NewSwatch" Height="34" CornerRadius="6" BorderBrush="#33333A" BorderThickness="1"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="Current" Foreground="#9A9AA5" FontSize="11"/>
                    <Border x:Name="CurrentSwatch" Height="34" CornerRadius="6" BorderBrush="#33333A" BorderThickness="1"/>
                </StackPanel>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="R" VerticalAlignment="Center" Margin="0,2,6,2"/>
                <TextBox x:Name="RBox" Grid.Column="1" Margin="0,2" TextChanged="Rgb_Changed"/>
                <TextBlock Grid.Column="2" Text="H" VerticalAlignment="Center" Margin="8,2,6,2"/>
                <TextBlock x:Name="HVal" Grid.Column="3" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Text="G" VerticalAlignment="Center" Margin="0,2,6,2"/>
                <TextBox x:Name="GBox" Grid.Row="1" Grid.Column="1" Margin="0,2" TextChanged="Rgb_Changed"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="S" VerticalAlignment="Center" Margin="8,2,6,2"/>
                <TextBlock x:Name="SVal" Grid.Row="1" Grid.Column="3" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="2" Text="B" VerticalAlignment="Center" Margin="0,2,6,2"/>
                <TextBox x:Name="BBox" Grid.Row="2" Grid.Column="1" Margin="0,2" TextChanged="Rgb_Changed"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="V" VerticalAlignment="Center" Margin="8,2,6,2"/>
                <TextBlock x:Name="BVal" Grid.Row="2" Grid.Column="3" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="3" Text="#" VerticalAlignment="Center" Margin="0,2,6,2"/>
                <TextBox x:Name="HexBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,2" TextChanged="Hex_Changed"/>
                <TextBlock Grid.Row="4" Text="Op." VerticalAlignment="Center" Margin="0,2,6,2"/>
                <Slider x:Name="AlphaSlider" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Minimum="0" Maximum="255" VerticalAlignment="Center" ValueChanged="Alpha_Changed"/>
                <TextBlock x:Name="AlphaVal" Grid.Row="4" Grid.Column="3" TextAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="OkBtn" Content="OK" Padding="0,6" Margin="0,0,4,0" Click="Ok_Click"/>
                <Button Grid.Column="1" Content="Cancel" Padding="0,6" Margin="4,0,0,0" Click="Cancel_Click"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
