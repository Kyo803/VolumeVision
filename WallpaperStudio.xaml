<Window x:Class="VolumeOSD.WallpaperStudio"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:VolumeOSD.Controls"
        Title="Wallpaper Studio" Width="1000" Height="720"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Topmost="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border x:Name="Shell" CornerRadius="20" Background="#0B0B0E" BorderBrush="#1E1E24" BorderThickness="1"
            RenderTransformOrigin="0.5,0.5" MouseLeftButtonDown="Shell_Drag">
        <Border.RenderTransform>
            <ScaleTransform x:Name="ShellScale" ScaleX="1" ScaleY="1"/>
        </Border.RenderTransform>
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== Header ===== -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Wallpaper Studio" FontSize="20" FontWeight="SemiBold" Foreground="#F4F4F7"/>
                    <TextBlock x:Name="FrameInfo" Text="No image loaded" Foreground="#5A5A64" FontSize="12"
                               Margin="12,4,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <Button x:Name="CloseBtn" Content="✕" Width="28" Height="28" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Style="{StaticResource GhostPillButton}" Padding="0" Click="Close_Click"/>
            </Grid>

            <!-- ===== Body: canvas (left) + tools (right) ===== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Canvas -->
                <StackPanel Grid.Column="0" Margin="0,0,18,0">
                    <TextBlock Text="PILL PREVIEW" Foreground="#5A5A64" FontSize="10" FontWeight="SemiBold" Margin="2,0,0,6"/>
                    <Border Width="480" Height="106" CornerRadius="53" HorizontalAlignment="Left"
                            Background="{DynamicResource PillBgBrush}"
                            BorderBrush="{DynamicResource PillBorderBrush}" BorderThickness="1"
                            ClipToBounds="True">
                        <Grid>
                            <Image x:Name="PreviewImage" Stretch="UniformToFill">
                                <Image.Clip>
                                    <RectangleGeometry Rect="0,0,480,106" RadiusX="53" RadiusY="53"/>
                                </Image.Clip>
                            </Image>
                            <Border CornerRadius="53" Background="{DynamicResource PillBgBrush}" Opacity="0.45"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="CANVAS — DRAG TO PAN" Foreground="#5A5A64" FontSize="10" FontWeight="SemiBold"
                               Margin="2,14,0,6"/>
                    <Border CornerRadius="14" BorderBrush="#2C2C33" BorderThickness="1" ClipToBounds="True">
                        <Image x:Name="CropImage" Width="480" Height="106" Stretch="Fill" Cursor="Hand"
                               MouseLeftButtonDown="Crop_Down" MouseMove="Crop_Move" MouseLeftButtonUp="Crop_Up"/>
                    </Border>

                    <Grid Margin="2,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="44"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Zoom" Foreground="#DCDCE2" FontSize="12" VerticalAlignment="Center"/>
                        <Slider x:Name="ZoomSlider" Grid.Column="1" Style="{StaticResource PillSlider}"
                                Minimum="100" Maximum="400" Value="100" VerticalAlignment="Center" Margin="0,0,10,0"
                                ValueChanged="Adjust_Changed"/>
                        <TextBlock x:Name="ZoomVal" Grid.Column="2" Text="100%" Foreground="#7A7A85" FontSize="12"
                                   TextAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>

                <!-- Tools -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Draw -->
                        <TextBlock Text="DRAW" Foreground="#5A5A64" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="DrawCheck" Content="Pen" Style="{StaticResource PillCheck}" VerticalAlignment="Center"/>
                            <Button x:Name="PenColorBtn" Grid.Column="1" Width="30" Height="22" Margin="8,0,0,0"
                                    Click="PenColor_Click" ToolTip="Pen color…" BorderBrush="#3A3A42" BorderThickness="1"/>
                            <Slider x:Name="PenSizeSlider" Grid.Column="2" Style="{StaticResource PillSlider}"
                                    Minimum="2" Maximum="40" Value="8" VerticalAlignment="Center" Margin="10,0,10,0"
                                    ValueChanged="PenSize_Changed"/>
                            <TextBlock x:Name="PenSizeVal" Grid.Column="3" Text="8" Foreground="#7A7A85" FontSize="12"
                                       TextAlignment="Right" VerticalAlignment="Center"/>
                            <Button Grid.Column="4" Content="Clear frame" Style="{StaticResource GhostPillButton}"
                                    Margin="8,0,0,0" Click="ClearFrame_Click"/>
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="BrushCombo" Style="{StaticResource DarkCombo}"
                                      SelectionChanged="Brush_Changed"/>
                            <Button Grid.Column="1" Content="Reload brushes" Style="{StaticResource GhostPillButton}"
                                    Margin="8,0,0,0" Click="ReloadBrushes_Click"/>
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="58"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Spacing" Foreground="#DCDCE2" FontSize="12" VerticalAlignment="Center"/>
                            <Slider x:Name="SpacingSlider" Grid.Column="1" Style="{StaticResource PillSlider}"
                                    Minimum="5" Maximum="200" Value="22" VerticalAlignment="Center" Margin="0,0,8,0"
                                    ValueChanged="Spacing_Changed"/>
                            <TextBlock x:Name="SpacingVal" Grid.Column="2" Text="22%" Foreground="#7A7A85" FontSize="11"
                                       TextAlignment="Right" VerticalAlignment="Center"/>
                            <Border Grid.Column="3" Width="34" Height="34" CornerRadius="8" Background="#1C1C21"
                                    BorderBrush="#2C2C33" BorderThickness="1" Margin="8,0,0,0">
                                <Image x:Name="BrushPreviewImg" Stretch="Uniform" Margin="3"/>
                            </Border>
                        </Grid>

                        <!-- Adjust -->
                        <TextBlock Text="ADJUST" Foreground="#5A5A64" FontSize="10" FontWeight="SemiBold" Margin="0,16,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="66"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="42"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Bright" Foreground="#DCDCE2" FontSize="12" VerticalAlignment="Center"/>
                            <Slider x:Name="BrightSlider" Grid.Column="1" Style="{StaticResource PillSlider}"
                                    Minimum="-100" Maximum="100" Value="0" VerticalAlignment="Center" Margin="0,0,10,0"
                                    ValueChanged="Adjust_Changed"/>
                            <TextBlock x:Name="BrightVal" Grid.Column="2" Text="0" Foreground="#7A7A85" FontSize="12"
                                       TextAlignment="Right" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="1" Text="Contrast" Foreground="#DCDCE2" FontSize="12" VerticalAlignment="Center"/>
                            <Slider x:Name="ContrastSlider" Grid.Row="1" Grid.Column="1" Style="{StaticResource PillSlider}"
                                    Minimum="0" Maximum="200" Value="100" VerticalAlignment="Center" Margin="0,0,10,0"
                                    ValueChanged="Adjust_Changed"/>
                            <TextBlock x:Name="ContrastVal" Grid.Row="1" Grid.Column="2" Text="100%" Foreground="#7A7A85" FontSize="12"
                                       TextAlignment="Right" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="2" Text="Satur." Foreground="#DCDCE2" FontSize="12" VerticalAlignment="Center"/>
                            <Slider x:Name="SatSlider" Grid.Row="2" Grid.Column="1" Style="{StaticResource PillSlider}"
                                    Minimum="0" Maximum="200" Value="100" VerticalAlignment="Center" Margin="0,0,10,0"
                                    ValueChanged="Adjust_Changed"/>
                            <TextBlock x:Name="SatVal" Grid.Row="2" Grid.Column="2" Text="100%" Foreground="#7A7A85" FontSize="12"
                                       TextAlignment="Right" VerticalAlignment="Center"/>

                            <CheckBox x:Name="GrayCheck" Grid.Row="3" Grid.ColumnSpan="3" Content="Black &amp; white"
                                      Style="{StaticResource PillCheck}" Margin="0,8,0,0"
                                      Checked="Adjust_Toggled" Unchecked="Adjust_Toggled"/>
                        </Grid>

                        <!-- Animate -->
                        <TextBlock Text="ANIMATE — KEN BURNS → GIF" Foreground="#5A5A64" FontSize="10" FontWeight="SemiBold"
                                   Margin="0,16,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="KbCombo" Style="{StaticResource DarkCombo}" Margin="0,0,6,0" SelectionChanged="Kb_Changed">
                                <ComboBoxItem Content="Off" IsSelected="True"/>
                                <ComboBoxItem Content="Zoom in"/>
                                <ComboBoxItem Content="Zoom out"/>
                                <ComboBoxItem Content="Pan sideways"/>
                            </ComboBox>
                            <ComboBox x:Name="DurCombo" Grid.Column="1" Style="{StaticResource DarkCombo}" Margin="0,0,6,0" SelectionChanged="Kb_Changed">
                                <ComboBoxItem Content="2 s" Tag="2"/>
                                <ComboBoxItem Content="3 s" Tag="3" IsSelected="True"/>
                                <ComboBoxItem Content="4 s" Tag="4"/>
                                <ComboBoxItem Content="6 s" Tag="6"/>
                            </ComboBox>
                            <ComboBox x:Name="FpsCombo" Grid.Column="2" Style="{StaticResource DarkCombo}" SelectionChanged="Kb_Changed">
                                <ComboBoxItem Content="10 fps" Tag="10"/>
                                <ComboBoxItem Content="12 fps" Tag="12" IsSelected="True"/>
                                <ComboBoxItem Content="15 fps" Tag="15"/>
                            </ComboBox>
                        </Grid>
                        <CheckBox x:Name="AnimCheck" Content="Play animation preview (loops)" Style="{StaticResource PillCheck}"
                                  Margin="2,10,0,0" Checked="Anim_Toggled" Unchecked="Anim_Toggled"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ===== Timeline (full width) ===== -->
            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                <Grid Margin="2,0,0,6">
                    <TextBlock Text="TIMELINE" Foreground="#5A5A64" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <CheckBox x:Name="OnionCheck" Content="Onion skin (ghost previous frame)"
                              Style="{StaticResource PillCheck}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <controls:Timeline x:Name="Timeline"/>
            </StackPanel>

            <!-- ===== Action bar ===== -->
            <Grid Grid.Row="3" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="" Foreground="#5A5A64" FontSize="11" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Open…" Style="{StaticResource PillButton}" Margin="0,0,8,0" Click="Open_Click"/>
                    <Button Content="Add GIF…" Style="{StaticResource PillButton}" Margin="0,0,8,0" Click="ImportGif_Click"/>
                    <Button Content="Save PNG" Style="{StaticResource PillButton}" Margin="0,0,8,0" Click="Png_Click"/>
                    <Button Content="Export GIF" Style="{StaticResource PillButton}" Click="Gif_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
