<Window x:Class="VolumeOSD.WallpaperStudio"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wallpaper studio" Width="560" SizeToContent="Height"
        Background="#111114" Foreground="#F2F2F5" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True">
    <StackPanel Margin="16" Orientation="Vertical">
        <TextBlock Text="Pill preview" FontWeight="Bold" Margin="0,0,0,6"/>
        <Border Width="400" Height="88" CornerRadius="44" HorizontalAlignment="Center"
                Background="{DynamicResource PillBgBrush}"
                BorderBrush="{DynamicResource PillBorderBrush}" BorderThickness="1" Margin="0,0,0,4">
            <Grid>
                <Image x:Name="PreviewImage" Stretch="UniformToFill">
                    <Image.Clip>
                        <RectangleGeometry Rect="0,0,400,88" RadiusX="44" RadiusY="44"/>
                    </Image.Clip>
                </Image>
                <Border CornerRadius="44" Background="{DynamicResource PillBgBrush}" Opacity="0.45"/>
            </Grid>
        </Border>
        <TextBlock Text="Crop — drag to pan (pill aspect locked)" Foreground="#9A9AA5" FontSize="11" Margin="0,0,0,4"/>
        <Image x:Name="CropImage" Width="480" Height="106" Stretch="Fill" Cursor="Hand"
               MouseLeftButtonDown="Crop_Down" MouseMove="Crop_Move" MouseLeftButtonUp="Crop_Up"/>

        <TextBlock Text="Frames — frame-by-frame animation" FontWeight="Bold" Margin="0,10,0,6"/>
        <ListBox x:Name="FilmStrip" Height="64" Background="#0B0B0E" BorderBrush="#33333A" BorderThickness="1"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 SelectionChanged="Film_Select">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Image Source="{Binding}" Width="120" Height="28" Stretch="UniformToFill" Margin="2"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="+ Blank" Padding="0,4" Margin="0,0,4,0" Click="FrameAdd_Click"/>
            <Button Grid.Column="1" Content="Duplicate" Padding="0,4" Margin="4,0,4,0" Click="FrameDupe_Click"/>
            <Button Grid.Column="2" Content="Delete" Padding="0,4" Margin="4,0,4,0" Click="FrameDel_Click"/>
            <Button Grid.Column="3" Content="Undo" Padding="0,4" Margin="4,0,0,0" Click="Undo_Click"/>
        </Grid>
        <CheckBox x:Name="OnionCheck" Content="Onion skin (ghost of previous frame)" Margin="0,6,0,0" Foreground="#F2F2F5"/>

        <TextBlock Text="Draw" FontWeight="Bold" Margin="0,10,0,6"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="44"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="44"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="DrawCheck" Content="Pen" VerticalAlignment="Center" Foreground="#F2F2F5"/>
            <Button x:Name="PenColorBtn" Grid.Column="1" Height="24" Margin="6,0,0,0" Click="PenColor_Click" ToolTip="Pen color…"/>
            <Slider x:Name="PenSizeSlider" Grid.Column="2" Minimum="2" Maximum="40" Value="8" VerticalAlignment="Center" Margin="6,0,0,0" ValueChanged="PenSize_Changed"/>
            <TextBlock x:Name="PenSizeVal" Grid.Column="3" Text="8" TextAlignment="Right" VerticalAlignment="Center"/>
            <Button Grid.Column="4" Content="Clear frame" Padding="8,4" Margin="6,0,0,0" Click="ClearFrame_Click"/>
        </Grid>
        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="44"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Zoom" VerticalAlignment="Center"/>
            <Slider x:Name="ZoomSlider" Grid.Column="1" Minimum="100" Maximum="400" Value="100" VerticalAlignment="Center" ValueChanged="Adjust_Changed"/>
            <TextBlock x:Name="ZoomVal" Grid.Column="2" Text="100%" TextAlignment="Right" VerticalAlignment="Center"/>
        </Grid>

        <TextBlock Text="Adjust" FontWeight="Bold" Margin="0,10,0,6"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="44"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Bright." VerticalAlignment="Center"/>
            <Slider x:Name="BrightSlider" Grid.Column="1" Minimum="-100" Maximum="100" Value="0" VerticalAlignment="Center" ValueChanged="Adjust_Changed"/>
            <TextBlock x:Name="BrightVal" Grid.Column="2" Text="0" TextAlignment="Right" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="1" Text="Contrast" VerticalAlignment="Center"/>
            <Slider x:Name="ContrastSlider" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="200" Value="100" VerticalAlignment="Center" ValueChanged="Adjust_Changed"/>
            <TextBlock x:Name="ContrastVal" Grid.Row="1" Grid.Column="2" Text="100%" TextAlignment="Right" VerticalAlignment="Center"/>
            <TextBlock Grid.Row="2" Text="Satur." VerticalAlignment="Center"/>
            <Slider x:Name="SatSlider" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="200" Value="100" VerticalAlignment="Center" ValueChanged="Adjust_Changed"/>
            <TextBlock x:Name="SatVal" Grid.Row="2" Grid.Column="2" Text="100%" TextAlignment="Right" VerticalAlignment="Center"/>
            <CheckBox x:Name="GrayCheck" Grid.Row="3" Grid.ColumnSpan="3" Content="Black &amp; white" Margin="0,4,0,0" Foreground="#F2F2F5" Checked="Adjust_Toggled" Unchecked="Adjust_Toggled"/>
        </Grid>

        <TextBlock Text="Animate (Ken Burns → GIF)" FontWeight="Bold" Margin="0,10,0,6"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="KbCombo" Margin="0,0,4,0" SelectionChanged="Kb_Changed">
                <ComboBoxItem Content="Off" IsSelected="True"/>
                <ComboBoxItem Content="Zoom in"/>
                <ComboBoxItem Content="Zoom out"/>
                <ComboBoxItem Content="Pan sideways"/>
            </ComboBox>
            <ComboBox x:Name="DurCombo" Grid.Column="1" Margin="4,0,4,0" SelectionChanged="Kb_Changed">
                <ComboBoxItem Content="2 s" Tag="2"/>
                <ComboBoxItem Content="3 s" Tag="3" IsSelected="True"/>
                <ComboBoxItem Content="4 s" Tag="4"/>
                <ComboBoxItem Content="6 s" Tag="6"/>
            </ComboBox>
            <ComboBox x:Name="FpsCombo" Grid.Column="2" Margin="4,0,0,0" SelectionChanged="Kb_Changed">
                <ComboBoxItem Content="10 fps" Tag="10"/>
                <ComboBoxItem Content="12 fps" Tag="12" IsSelected="True"/>
                <ComboBoxItem Content="15 fps" Tag="15"/>
            </ComboBox>
        </Grid>
        <CheckBox x:Name="AnimCheck" Content="Play animation preview (loops)" Margin="0,6,0,0" Foreground="#F2F2F5" Checked="Anim_Toggled" Unchecked="Anim_Toggled"/>
        <TextBlock x:Name="FrameInfo" Text="No image loaded" Foreground="#9A9AA5" FontSize="11" Margin="0,4,0,0"/>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="Open…" Padding="0,6" Margin="0,0,4,0" Click="Open_Click"/>
            <Button Grid.Column="1" Content="Add GIF…" Padding="0,6" Margin="4,0,4,0" Click="ImportGif_Click"/>
            <Button Grid.Column="2" Content="Save PNG" Padding="0,6" Margin="4,0,4,0" Click="Png_Click"/>
            <Button Grid.Column="3" Content="Export GIF" Padding="0,6" Margin="4,0,4,0" Click="Gif_Click"/>
            <Button Grid.Column="4" Content="Close" Padding="0,6" Margin="4,0,0,0" Click="Close_Click"/>
        </Grid>
        <TextBlock x:Name="StatusText" Text="" Foreground="#9A9AA5" FontSize="11" Margin="0,6,0,0"/>
    </StackPanel>
</Window>
